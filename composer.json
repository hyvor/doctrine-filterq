{
    "name": "hyvor/symfony-filterq",
    "description": "Advanced filtering for Symfony/Doctrine ORM APIs",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "SupunKavinda",
            "email": "supun@hyvor.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "doctrine/orm": "^2.17|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10",
        "doctrine/dbal": "^3.0|^4.0",
        "symfony/cache": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "Hyvor\\FilterQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hyvor\\FilterQ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse"
    }
}
